# Credenciais de integracao (opcional — o modo planilha funciona sem nada disso).
# Copie este arquivo para .env e preencha o que voce tiver.
# O .env nunca deve ser versionado (ja esta no .gitignore).

# ── Banco/local ─────────────────────────────────────────────────────────────
# Pasta de dados do agente (padrao: marketplace-agent/dados)
# MKT_HOME=/home/voce/marketplace-agent/dados
# Caminho do banco SQLite (padrao: $MKT_HOME/mkt.db)
# MKT_DB=/home/voce/marketplace-agent/dados/mkt.db

# ── Shopee Open Platform ────────────────────────────────────────────────────
# https://open.shopee.com → Console → App Management
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URL=http://localhost:8765/shopee/callback
# producao | sandbox
SHOPEE_ENV=sandbox

# ── TikTok Shop Partner Center ──────────────────────────────────────────────
# https://partner.tiktokshop.com → App Management
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URL=http://localhost:8765/tiktok/callback
# producao | sandbox
TIKTOK_ENV=sandbox

# ── UpSeller (ERP) — API aberta/MCP (planos Profissional+ ou Kit) ────────────
# Painel UpSeller -> Plataforma Aberta -> API Privada -> Gerar
UPSELLER_CLIENT_ID=
UPSELLER_API_TOKEN=
UPSELLER_MCP_TOKEN=

# ── Notificacoes ────────────────────────────────────────────────────────────
# Telegram (recomendado): @BotFather -> /newbot -> token; @userinfobot -> chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API (Meta) — exige conta Business verificada + numero dedicado
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DESTINO=
